{
  "name": "gujar-milk",
  "version": "1.0.0",
  "description": "Gujjar Milk (گجر ملک شاپ) — Dairy POS, Cashier Billing, Inventory & Sales Management System",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
